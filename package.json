{
  "name": "openclaw-command-center",
  "version": "0.1.0",
  "description": "A voice-first command center for OpenClaw: live gateway state, approvals and realtime Talk on one screen.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abu-b-sidq/openclaw-command-center.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "start": "node server/src/main.ts",
    "dev": "ng serve --proxy-config web/proxy.conf.json",
    "dev:server": "node --watch server/src/main.ts",
    "set-password": "node server/src/cli/set-password.ts",
    "typecheck": "tsc -p server/tsconfig.json",
    "test": "node --test \"server/test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
